{
  "name": "raschpetzer-qanat-viz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive 3D visualization of the Raschp\u00ebtzer Roman qanat (Walferdange, Luxembourg), driven by a cited Single Source of Truth.",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/bake.mjs",
    "bake": "node scripts/bake.mjs",
    "validate": "node scripts/validate.mjs",
    "sample:lidar": "node scripts/sample-lidar.mjs",
    "seed:lidar": "node scripts/sample-lidar.mjs --seed",
    "bake:lidar": "node scripts/bake-lidar.mjs",
    "bake:ortho": "node scripts/bake-ortho.mjs",
    "bake:vectors": "node scripts/bake-vectors.mjs",
    "bake:hillshade": "node scripts/bake-hillshade.mjs",
    "bake:basemaps": "node scripts/bake-basemaps.mjs",
    "bake:overlays": "node scripts/bake-overlays.mjs",
    "bake:paths": "node scripts/bake-paths.mjs",
    "build": "node scripts/build.mjs",
    "prebuild": "node scripts/validate.mjs",
    "serve": "vite preview",
    "bake:context": "node scripts/bake-context.mjs",
    "bake:buildings": "node scripts/bake-buildings.mjs"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  }
}
